<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.ecomarket</groupId>
    <artifactId>ecomarket-desktop</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>ecoMarket Desktop</name>
    <description>EcoMarket - frontend-only JavaFX marketplace prototype (FXML + CSS + mock data)</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <javafx.version>21.0.2</javafx.version>
        <postgresql.version>42.7.3</postgresql.version>
        <hikaricp.version>5.1.0</hikaricp.version>
        <jackson.version>2.17.0</jackson.version>
        <slf4j.version>2.0.12</slf4j.version>
        <logback.version>1.5.3</logback.version>
        <jakarta.persistence.version>3.1.0</jakarta.persistence.version>

        <!-- Brand / installer settings (icons live in src/main/resources/assets/icons). -->
        <jpackage.version>1.0.0</jpackage.version>
        <jpackage.icon>${project.basedir}/src/main/resources/assets/icons/ecomarket.ico</jpackage.icon>
    </properties>

    <dependencies>
        <!-- JavaFX Controls & FXML -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Jakarta Persistence API (Entity Annotations) -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
            <version>${jakarta.persistence.version}</version>
        </dependency>

        <!-- Supabase / PostgreSQL JDBC Driver -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
        </dependency>

        <!-- High-Performance Connection Pooling -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>${hikaricp.version}</version>
        </dependency>

        <!-- JSON & Date serialization (Supabase REST / DTOs) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- Environment variable / .env support -->
        <dependency>
            <groupId>io.github.cdimascio</groupId>
            <artifactId>dotenv-java</artifactId>
            <version>3.0.0</version>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compiler plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>

            <!-- Adds Implementation-Version so the About dialog matches the POM. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Implementation-Title>EcoMarket</Implementation-Title>
                            <Implementation-Version>${project.version}</Implementation-Version>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <!-- JavaFX Maven Plugin for running the desktop app -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <executions>
                    <execution>
                        <!-- Default configuration for running with: mvn javafx:run -->
                        <id>default-cli</id>
                        <configuration>
                            <mainClass>com.ecomarket.app.Main</mainClass>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Surefire for Unit Testing -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>

    <!--
      Native installer packaging. Opt in with -DdesktopInstaller so normal
      `mvn test` / `mvn javafx:run` never need jpackage or platform SDKs.
      The OS-specific profile below picks ecomarket.ico or ecomarket.icns.
    -->
    <profiles>
        <profile>
            <id>installer-windows</id>
            <activation>
                <property><name>desktopInstaller</name></property>
                <os><family>windows</family></os>
            </activation>
            <properties>
                <jpackage.icon>${project.basedir}/src/main/resources/assets/icons/ecomarket.ico</jpackage.icon>
            </properties>
        </profile>

        <profile>
            <id>installer-mac</id>
            <activation>
                <property><name>desktopInstaller</name></property>
                <os><family>mac</family></os>
            </activation>
            <properties>
                <jpackage.icon>${project.basedir}/src/main/resources/assets/icons/ecomarket.icns</jpackage.icon>
            </properties>
        </profile>

        <profile>
            <id>desktop-installer</id>
            <activation>
                <property><name>desktopInstaller</name></property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.6.1</version>
                        <executions>
                            <execution>
                                <id>copy-jpackage-dependencies</id>
                                <phase>prepare-package</phase>
                                <goals><goal>copy-dependencies</goal></goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/jpackage-input</outputDirectory>
                                    <includeScope>runtime</includeScope>
                                    <overWriteReleases>true</overWriteReleases>
                                    <overWriteSnapshots>true</overWriteSnapshots>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Put the app jar beside its runtime dependencies for jpackage. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <configuration>
                            <outputDirectory>${project.build.directory}/jpackage-input</outputDirectory>
                        </configuration>
                    </plugin>

                    <plugin>
                        <groupId>com.github.akman</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <version>0.1.5</version>
                        <executions>
                            <execution>
                                <id>build-installer</id>
                                <phase>verify</phase>
                                <goals><goal>jpackage</goal></goals>
                                <configuration>
                                    <name>EcoMarket</name>
                                    <appversion>${jpackage.version}</appversion>
                                    <vendor>EcoMarket</vendor>
                                    <description>EcoMarket — Reuse. Resell. Rehome.</description>
                                    <copyright>Copyright 2026 EcoMarket</copyright>
                                    <input>${project.build.directory}/jpackage-input</input>
                                    <mainjar>${project.build.finalName}.jar</mainjar>
                                    <mainclass>com.ecomarket.app.Main</mainclass>
                                    <icon>${jpackage.icon}</icon>
                                    <dest>${project.build.directory}/jpackage</dest>
                                    <type>PLATFORM</type>
                                    <winmenu>true</winmenu>
                                    <winmenugroup>EcoMarket</winmenugroup>
                                    <winshortcut>true</winshortcut>
                                    <winperuserinstall>true</winperuserinstall>
                                    <winupgradeuuid>8CF81762-0B19-46A6-875E-1F839A1700D0</winupgradeuuid>
                                    <macpackageidentifier>io.ecomarket.desktop</macpackageidentifier>
                                    <macpackagename>EcoMarket</macpackagename>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
