<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Form half only. Shared by AuthLayout; ids/actions match LoginController. -->
<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ecomarket.controller.LoginController"
      spacing="14" styleClass="auth-form-body">

    <Label text="Log in" styleClass="auth-form-title"/>

    <Label fx:id="errorLabel" styleClass="auth-error-label" visible="false" managed="false"/>

    <VBox spacing="5" styleClass="auth-field">
        <Label text="Email" styleClass="auth-field-label"/>
        <TextField fx:id="emailField" promptText="you@example.com" styleClass="auth-input"
                   onKeyPressed="#onEnter"/>
        <Label fx:id="emailError" styleClass="auth-field-error" visible="false" managed="false"/>
    </VBox>

    <VBox spacing="5" styleClass="auth-field">
        <Label text="Password" styleClass="auth-field-label"/>
        <HBox spacing="8" styleClass="auth-password-row">
            <PasswordField fx:id="passwordField" HBox.hgrow="ALWAYS"
                           promptText="At least 6 characters" styleClass="auth-input"
                           onKeyPressed="#onEnter"/>
            <TextField fx:id="passwordVisibleField" HBox.hgrow="ALWAYS"
                       promptText="At least 6 characters" styleClass="auth-input"
                       visible="false" managed="false" onKeyPressed="#onEnter"/>
            <Button fx:id="passwordToggle" text="Show" styleClass="auth-eye-toggle"
                    onAction="#onTogglePassword" focusTraversable="false"/>
        </HBox>
        <Label fx:id="passwordError" styleClass="auth-field-error" visible="false" managed="false"/>
    </VBox>

    <Button fx:id="submitButton" text="Log in" styleClass="auth-primary" onAction="#onLogin"
            maxWidth="1.7976931348623157E308"/>

    <HBox alignment="CENTER" spacing="6" styleClass="auth-switch-row">
        <Label text="New here?" styleClass="auth-switch-text"/>
        <Hyperlink text="Register" styleClass="auth-switch-link" onAction="#onRegister"/>
    </HBox>
</VBox>
