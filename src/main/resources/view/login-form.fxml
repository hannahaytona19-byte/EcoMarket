<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Form half only. Shared by AuthLayout; all fx:ids/actions match LoginController. -->
<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ecomarket.controller.LoginController"
      spacing="14" styleClass="auth-form-body">

    <Label text="Login" styleClass="auth-form-title"/>

    <Label fx:id="errorLabel" styleClass="auth-error-label" visible="false" managed="false"/>

    <VBox spacing="5" styleClass="auth-field">
        <Label text="Email" styleClass="auth-field-label"/>
        <TextField fx:id="emailField" promptText="you@example.com" styleClass="auth-input"
                   onKeyPressed="#onEnter"/>
    </VBox>

    <VBox spacing="5" styleClass="auth-field">
        <Label text="Password" styleClass="auth-field-label"/>
        <PasswordField fx:id="passwordField" promptText="At least 6 characters" styleClass="auth-input"
                       onKeyPressed="#onEnter"/>
    </VBox>

    <Button fx:id="submitButton" text="Login" styleClass="auth-primary" onAction="#onLogin"
            maxWidth="1.7976931348623157E308"/>

    <HBox alignment="CENTER" spacing="6" styleClass="auth-switch-row">
        <Label text="Don't have an account?" styleClass="auth-switch-text"/>
        <Hyperlink text="Register here" styleClass="auth-switch-link" onAction="#onRegister"/>
    </HBox>
</VBox>
