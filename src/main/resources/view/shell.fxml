<?xml version="1.0" encoding="UTF-8"?>

<?import com.ecomarket.ui.LogoView?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ecomarket.controller.ShellController"
            styleClass="landing-root">

    <left>
        <VBox fx:id="sidebar" prefWidth="220" spacing="0" styleClass="sidebar">
            <HBox alignment="CENTER" spacing="8" styleClass="sidebar-brand">
                <LogoView fx:id="sidebarLogo"/>
            </HBox>

            <!-- Single persistent nav list, generated once by ShellController. -->
            <VBox fx:id="navItems" spacing="6" alignment="TOP_LEFT" styleClass="nav-list"/>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox spacing="8" styleClass="sidebar-footer">
                <Label text="Reuse. Resell. Rehome." styleClass="sidebar-tagline" wrapText="true"
                       textAlignment="CENTER"/>
                <Button text="Logout" styleClass="button-ghost" onAction="#onLogout"/>
            </VBox>
        </VBox>
    </left>

    <top>
        <HBox fx:id="topBar" alignment="CENTER_LEFT" spacing="14" styleClass="topbar">
            <Label fx:id="pageTitle" text="Browse" styleClass="page-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="searchField" promptText="Search items..."
                       styleClass="search-field" onKeyPressed="#onSearchKey"/>
            <Button fx:id="notificationButton" styleClass="icon-button" onAction="#onNotifications">
                <graphic>
                    <Label text="🔔"/>
                </graphic>
            </Button>
            <Button fx:id="settingsButton" styleClass="icon-button" onAction="#onProfile">
                <graphic>
                    <Label text="⚙"/>
                </graphic>
            </Button>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="contentPane" styleClass="content-pane"/>
    </center>
</BorderPane>
