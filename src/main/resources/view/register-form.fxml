<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Form half only. Shared by AuthLayout; all fx:ids/actions match RegisterController. -->
<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ecomarket.controller.RegisterController"
      spacing="14" styleClass="auth-form-body">

    <Label text="Sign up" styleClass="auth-form-title"/>

    <Label fx:id="errorLabel" styleClass="auth-error-label" visible="false" managed="false"/>

    <HBox spacing="12">
        <VBox spacing="5" HBox.hgrow="ALWAYS" styleClass="auth-field">
            <Label text="First Name" styleClass="auth-field-label"/>
            <TextField fx:id="firstNameField" promptText="Juan" styleClass="auth-input"/>
        </VBox>
        <VBox spacing="5" HBox.hgrow="ALWAYS" styleClass="auth-field">
            <Label text="Last Name" styleClass="auth-field-label"/>
            <TextField fx:id="lastNameField" promptText="Dela Cruz" styleClass="auth-input"/>
        </VBox>
    </HBox>

    <VBox spacing="5" styleClass="auth-field">
        <Label text="Email" styleClass="auth-field-label"/>
        <TextField fx:id="emailField" promptText="you@example.com" styleClass="auth-input"/>
    </VBox>

    <VBox spacing="5" styleClass="auth-field">
        <Label text="Password" styleClass="auth-field-label"/>
        <PasswordField fx:id="passwordField" promptText="At least 6 characters" styleClass="auth-input"
                       onKeyPressed="#onEnter"/>
    </VBox>

    <Button fx:id="submitButton" text="Register" styleClass="auth-primary" onAction="#onRegister"
            maxWidth="1.7976931348623157E308"/>

    <HBox alignment="CENTER" spacing="6" styleClass="auth-switch-row">
        <Label text="Already a Member?" styleClass="auth-switch-text"/>
        <Hyperlink text="Sign in here" styleClass="auth-switch-link" onAction="#onLogin"/>
    </HBox>
</VBox>
