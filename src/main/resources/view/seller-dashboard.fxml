<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ecomarket.controller.SellerDashboardController"
      styleClass="page-root" VBox.vgrow="ALWAYS">
    <VBox spacing="16" styleClass="page-body" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT">
            <VBox spacing="3">
                <Label text="Seller Dashboard" styleClass="page-title"/>
                <Label text="Manage the items you have listed for rehoming."
                       styleClass="section-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="postButton" text="+  Post New Item" styleClass="button-primary"
                    onAction="#onPost"/>
        </HBox>

        <HBox spacing="14">
            <VBox spacing="4" styleClass="summary-card">
                <Label text="Active Listings" styleClass="summary-label"/>
                <Label fx:id="activeCount" text="0" styleClass="summary-value"/>
            </VBox>
            <VBox spacing="4" styleClass="summary-card">
                <Label text="Sold Items" styleClass="summary-label"/>
                <Label fx:id="soldCount" text="0" styleClass="summary-value"/>
            </VBox>
            <VBox spacing="4" styleClass="summary-card">
                <Label text="Unread Messages" styleClass="summary-label"/>
                <Label fx:id="unreadCount" text="0" styleClass="summary-value"/>
            </VBox>
            <VBox spacing="4" styleClass="summary-card">
                <Label text="CO₂ Saved (kg)" styleClass="summary-label"/>
                <Label fx:id="carbonCount" text="0.00" styleClass="summary-value"/>
            </VBox>
        </HBox>

        <VBox spacing="8" VBox.vgrow="ALWAYS">
            <Label text="My Listings" styleClass="section-title"/>
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                <VBox fx:id="listingRows" spacing="8"/>
            </ScrollPane>
        </VBox>
    </VBox>
</VBox>
