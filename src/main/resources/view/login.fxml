<?xml version="1.0" encoding="UTF-8"?>

<?import com.ecomarket.ui.LogoView?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.input.KeyCode?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.ecomarket.controller.LoginController"
           styleClass="landing-root">
    <VBox spacing="0" maxWidth="980" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="navbar">
            <LogoView fx:id="navbarLogo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Don't have an account?" styleClass="section-subtitle"/>
            <Hyperlink text="Register" styleClass="nav-link" onAction="#onRegister"/>
        </HBox>

        <VBox alignment="CENTER" spacing="18" VBox.vgrow="ALWAYS">
            <VBox spacing="12" styleClass="auth-card">
                <LogoView fx:id="cardLogo"/>
                <Label text="Login" styleClass="form-title"/>
                <Label text="Welcome back. Pick up where you left off." styleClass="section-subtitle"/>
                <Label fx:id="errorLabel" styleClass="error-label" visible="false" managed="false"/>

                <VBox spacing="4">
                    <Label text="Email" styleClass="form-label"/>
                    <TextField fx:id="emailField" promptText="you@example.com" styleClass="input-field"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="Password" styleClass="form-label"/>
                    <PasswordField fx:id="passwordField" promptText="At least 6 characters"
                                   styleClass="input-field" onKeyPressed="#onEnter"/>
                </VBox>

                <Button text="Login" styleClass="button-primary" onAction="#onLogin"
                        maxWidth="1.7976931348623157E308" defaultButton="true"/>
                <HBox alignment="CENTER" spacing="6">
                    <Label text="Don't have an account?" styleClass="section-subtitle"/>
                    <Hyperlink text="Register" styleClass="nav-link" onAction="#onRegister"/>
                </HBox>
            </VBox>
        </VBox>
    </VBox>
</StackPane>
